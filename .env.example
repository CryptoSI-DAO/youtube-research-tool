# YouTube Research Tool — Environment Variables
# Copy this to .env.local for local development
# Set these in Vercel dashboard for production

# Webhook URL (your server's public endpoint)
WEBHOOK_URL=http://localhost:8765/webhook

# Webhook auth token (must match WEBHOOK_TOKEN on the server)
WEBHOOK_TOKEN=change-me-in-production

# Access password hash (SHA-256 of your password)
# Generate: echo -n "your-password" | sha256sum
ACCESS_PASSWORD_HASH=
