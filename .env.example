# Vercel Frontend Environment Variables
# Copy to .env.local for local dev. Set these in Vercel dashboard for production.

# URL of the webhook server (your backend)
WEBHOOK_URL=http://localhost:8765/webhook

# Shared secret for webhook auth (generate a random string)
WEBHOOK_TOKEN=change-me-to-a-random-secret

# Password for frontend access (min 4 chars, will be hashed server-side)
ACCESS_PASSWORD_HASH=
